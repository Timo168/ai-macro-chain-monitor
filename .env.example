# Optional. Without a key the collector uses the FRED public CSV adapter.
FRED_API_KEY=
# Keep real keys in the scheduled process environment, never in NEXT_PUBLIC_*.
# Default is local-only inference, without external API charges.
REASONING_PROVIDER=ollama
REASONING_ENABLED=false
REASONING_LOCAL_BASE_URL=http://127.0.0.1:11434
REASONING_LOCAL_CONTEXT_TOKENS=40960
REASONING_LOCAL_MAX_OUTPUT_TOKENS=12288
REASONING_LOCAL_TIMEOUT_SECONDS=600
# Optional. Only explicitly selected openai provider reads this key.
OPENAI_API_KEY=
# Ollama model must already be downloaded locally. No cloud fallback.
REASONING_MODEL=qwen3:8b
# Optional SEC contact identity for fair-access requests; keep this server-side.
# Example: YourOrganization contact@example.com
SEC_USER_AGENT=

# Server-only reasoning controls. Output budget includes reasoning tokens.
REASONING_EFFORT=medium
REASONING_MAX_OUTPUT_TOKENS=16000
REASONING_TIMEOUT_SECONDS=180
REASONING_MAX_DAILY_CALLS=8
REASONING_RETRY_MINUTES=60
