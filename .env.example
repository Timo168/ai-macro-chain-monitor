# Optional. Without a key the collector uses the FRED public CSV adapter.
FRED_API_KEY=
# Keep real keys in the scheduled process environment, never in NEXT_PUBLIC_*.
# Optional. Only the background industry-research step reads this key.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.4 in the constrained research generator.
REASONING_MODEL=gpt-5.4
# Optional SEC contact identity for fair-access requests; keep this server-side.
# Example: YourOrganization contact@example.com
SEC_USER_AGENT=

# Server-only reasoning controls. Output budget includes reasoning tokens.
REASONING_EFFORT=medium
REASONING_MAX_OUTPUT_TOKENS=16000
REASONING_TIMEOUT_SECONDS=180
REASONING_MAX_DAILY_CALLS=8
REASONING_RETRY_MINUTES=60
