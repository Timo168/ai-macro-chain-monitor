import type {ObservationItem,ObserverInputs} from './observer-types';
export type NoteSnapshot={itemId:string;title:string;kind:string;value:string;unit:string;period:string;status:string;sourceUrl:string|null;sourceVersion:string|null;checkedAt:string|null};
export type NoteFields={title:string;judgment:string;evidence:string;reviewOn:string|null};
export type ResearchNote=NoteFields&{id:string;createdAt:string;updatedAt:string;snapshot:NoteSnapshot};
export type WeekRange={start:string;end:string};
export type Disclosure={kind:string;title:string;date:string;period:string;detail:string;sourceUrl:string|null;version:string};
export type WeeklyReport={range:WeekRange;generatedAt:string;notes:ResearchNote[];disclosures:Disclosure[];snapshots:NoteSnapshot[];limitations:string};
export const NOTEBOOK_SCHEMA:string;
export const MAX_BACKUP_BYTES:number;
export const MAX_NOTES:number;
export function safeSourceUrl(value:unknown):string|null;
export function escapeHtml(value:unknown):string;
export function beijingDay(value:unknown):string|null;
export function weekRange(day:string):WeekRange;
export function inWeek(date:string,range:WeekRange):boolean;
export function snapshotItem(item:ObservationItem):NoteSnapshot;
export function createNote(item:ObservationItem,fields:NoteFields,options?:{id?:string;now?:string}):ResearchNote;
export function editNote(note:ResearchNote,fields:NoteFields,now?:string):ResearchNote;
export function serializeNotebook(notes:ResearchNote[],now?:string):string;
export function parseNotebook(input:string):ResearchNote[];
export function mergeNotes(existing:ResearchNote[],incoming:ResearchNote[]):{notes:ResearchNote[];added:number;skipped:number};
export function collectDisclosures(inputs:ObserverInputs,range:WeekRange):Disclosure[];
export function buildWeeklyReport(options:{notes:ResearchNote[];items:ObservationItem[];inputs:ObserverInputs;day:string;now?:string}):WeeklyReport;
export function weeklyMarkdown(report:WeeklyReport):string;
export function weeklyHtml(report:WeeklyReport):string;
